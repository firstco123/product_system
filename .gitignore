# Claude / IDE
.claude/
.vscode/
.idea/
*.swp

# Docs working files (keep source scripts, ignore generated artifacts)
docs/**

# Environment / secrets
.env
.env.*
!.env.example
**/credentials*.json
**/service-account*.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Virtual environments
.venv/
venv/
env/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs / local data
*.log
logs/
*.db
*.sqlite3
/data/
/tmp/

# Terraform
*.tfstate
*.tfstate.*
.terraform/
# Saved plans. `terraform show -json` on one of these prints every attribute
# of every resource, including the Cloud SQL password in the service env.
tfplan
*.tfplan
infra/terraform/terraform.tfvars
# Ignore all real tfvars (may hold secrets) but keep the tracked *.example templates.
*.tfvars
!*.tfvars.example
!infra/terraform/.terraform.lock.hcl

# Local toolchains (terraform binary etc.)
.local/
**.csv
**.xlsx
**.docx
/csv_file/**.jpg
/csv_file/New folder/**.pdf

# ...except these. They are not shop data: they are OUR reviewed judgements
# about the Rakuten catalogue, derived from analysis that cost real effort.
# Losing them on a fresh checkout is silent — the conflicts simply reopen, the
# excluded pages come back as products, and the superseded masters reappear on
# the count sheet beside the variants that replaced them.
!/csv_file/phase2/source/rakuten_conflict_decisions.csv
!/csv_file/phase2/source/rakuten_excluded_pages.csv
!/csv_file/phase2/source/stocktake_excluded_skus.csv

# Dry-run and backfill transcripts written by scripts/*.ps1. Generated
# artefacts: they can carry connection strings, and with no .gcloudignore they
# ride into the Cloud Build source archive on every deploy.
/*_dryrun_*.txt
/backfill_*.txt
/*.transcript.txt
